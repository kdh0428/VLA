\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {AutoVLA: large failure-selected effects and smaller evaluation-frame effects.} RN is Recent-GT minus Normal; RV is Reverse-N minus Full-GT; P1-C is the new-drive set; ``Matched F'' is the matched-prefix failure stratum. The matched-prefix panel changes only the latest context value within each older-context condition. Bars are approximate 95\% drive-cluster $t$ intervals retained under the interval policy (Supplementary Sec.~B); hollow points mark withheld intervals, not zero uncertainty. F, E, and E4 are different estimands.}}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig:effects}{{3}{5}{\textbf {AutoVLA: large failure-selected effects and smaller evaluation-frame effects.} RN is Recent-GT minus Normal; RV is Reverse-N minus Full-GT; P1-C is the new-drive set; ``Matched F'' is the matched-prefix failure stratum. The matched-prefix panel changes only the latest context value within each older-context condition. Bars are approximate 95\% drive-cluster $t$ intervals retained under the interval policy (Supplementary Sec.~B); hollow points mark withheld intervals, not zero uncertainty. F, E, and E4 are different estimands}{figure.caption.9}{}}
\newlabel{fig:effects@cref}{{[figure][3][]3}{[1][4][]5}{}{}{}}
