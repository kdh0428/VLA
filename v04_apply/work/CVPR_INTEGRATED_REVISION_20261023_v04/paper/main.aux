\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The same latest-context correction can help or harm a generated AutoVLA plan.} Stored front-camera frames and open-loop plans from matched-prefix F. Blue uses GT at the latest context position with a natural older value (cell NAT\_REF of Fig.~\ref {fig:design}); orange uses the frozen Normal-source value there (cell NAT\_NSRC). Both share the black emitted prefix. FDE pairs are blue/orange at 5\,s. Cases are selected near group-median scene FDE differences: 87/100 scenes have a lower scene-mean severe-event rate, 12 an unchanged rate, and one a higher rate. Images show the current front view only. Axes differ across cases. Post-hoc illustrations, not representative samples or closed-loop driving results.}}{3}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:cases}{{1}{3}{\textbf {The same latest-context correction can help or harm a generated AutoVLA plan.} Stored front-camera frames and open-loop plans from matched-prefix F. Blue uses GT at the latest context position with a natural older value (cell NAT\_REF of Fig.~\ref {fig:design}); orange uses the frozen Normal-source value there (cell NAT\_NSRC). Both share the black emitted prefix. FDE pairs are blue/orange at 5\,s. Cases are selected near group-median scene FDE differences: 87/100 scenes have a lower scene-mean severe-event rate, 12 an unchanged rate, and one a higher rate. Images show the current front view only. Axes differ across cases. Post-hoc illustrations, not representative samples or closed-loop driving results}{figure.caption.2}{}}
\newlabel{fig:cases@cref}{{[figure][1][]1}{[1][2][]3}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {AutoVLA matched-prefix design.} Cells share all emitted pre-anchor actions; only the older ($t^*{+}1$) and latest ($a{-}1$) context positions differ, and their frozen values remain available during suffix generation. Positive $C_{\mathrm  {NAT}}$ means the latest Normal-source value is more harmful than GT behind a natural older value. Corrected-source cells are omitted. Context edits never replace emitted actions.}}{3}{figure.caption.5}\protected@file@percent }
\newlabel{fig:design}{{2}{3}{\textbf {AutoVLA matched-prefix design.} Cells share all emitted pre-anchor actions; only the older ($t^*{+}1$) and latest ($a{-}1$) context positions differ, and their frozen values remain available during suffix generation. Positive $C_{\NAT }$ means the latest Normal-source value is more harmful than GT behind a natural older value. Corrected-source cells are omitted. Context edits never replace emitted actions}{figure.caption.5}{}}
\newlabel{fig:design@cref}{{[figure][2][]2}{[1][2][]3}{}{}{}}
